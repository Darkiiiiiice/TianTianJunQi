{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model.schema.json",
  "title": "ModelArchitecture",
  "description": "model.json：网络结构描述，Python 导出、MLX Swift 按同一份配置重建（设计文档 §8.6）",
  "type": "object",
  "required": ["schema", "architecture", "input", "trunk", "heads"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "architecture": { "type": "string", "examples": ["cnn_policy_value"] },
    "input": {
      "type": "object",
      "required": ["rows", "cols", "channels"],
      "additionalProperties": false,
      "properties": {
        "rows": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 }
      }
    },
    "trunk": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 1
    },
    "heads": {
      "type": "object",
      "required": ["policy", "value"],
      "additionalProperties": false,
      "properties": {
        "policy": { "type": "string", "examples": ["cells"] },
        "value": { "const": 1 }
      }
    }
  }
}
